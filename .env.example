# HesapKitap — TÜM AYARLAR İSTEĞE BAĞLIDIR.
# Hızlı kurulumda .env gerekmez: şifre ilk açılışta, anahtarlar Ayarlar → Anahtarlar sayfasından girilir.
# Buraya yazılan değerler uygulama içindekinden önceliklidir (sunucu yöneticileri için).

# Giriş şifresi. Boşsa ilk açılışta uygulamadan belirlenir (hash'lenerek saklanır).
APP_PASSWORD=
# Oturum imza anahtarı. Boşsa otomatik üretilir.
SECRET_KEY=
# HTTPS arkasında çerezi zorla Secure yap (proxy X-Forwarded-Proto gönderiyorsa gerek yok)
COOKIE_SECURE=0

# Fiş/fatura/ekstre okuma — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Telegram hatırlatma ve yedek — @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Telegram'a giden şifreli yedeğin şifresi. KAYBETME: yedek bu olmadan açılamaz.
BACKUP_PASSPHRASE=

# Hızlı kurulum portu (docker-compose.yml)
HESAPKITAP_PORT=8080
